<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarkStart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarkStart.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="page-header">
        <div class="header-inner">
            <div class="brand-block">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="MarkStart home">
                    <img src="~/imagenes/LogoHorizontal.png" alt="MarkStart" class="brand-logo" />
                </a>
            </div>

            @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); var isHome = currentController == "Home" && currentAction == "Index"; var isNosotros = currentController == "Home" && (currentAction == "Privacy" || currentAction == "Nosotros"); var isMarketing = currentController == "Home" && (currentAction == "Privacy" || currentAction == "Marketing"); var isCursos = currentController == "Home" && currentAction == "Cursos"; }
            <nav class="header-nav" aria-label="Main navigation">
                <a class="header-link @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="header-link @(isNosotros ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Nosotros</a>
                <a class="header-link @(isMarketing ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Marketing</a>
                @if (!string.IsNullOrEmpty(Context.Session.GetString("Usuario")))
                {
                    <a class="header-link @(isCursos ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Cursos">Cursos</a>
                }
            </nav>

            <div class="header-right">
                @if (!string.IsNullOrEmpty(Context.Session.GetString("Usuario")))
                {
                    var usuario = Context.Session.GetString("Usuario");
                    var nombre = Context.Session.GetString("Nombre");
                    var foto = Context.Session.GetString("FotoPerfil");

                    <div class="user-block">
                        @if (!string.IsNullOrEmpty(foto))
                        {
                            <img src="@Url.Content("~/" + foto)" alt="FotoPerfil" class="user-avatar" />
                        }
                        else
                        {
                            <div class="user-avatar user-avatar--placeholder"></div>
                        }
                        <div class="user-name">@(!string.IsNullOrEmpty(nombre) ? nombre : usuario)</div>
                    </div>
                }
                else
                {
                    <a class="btn-login" asp-area="" asp-controller="Home" asp-action="InicioSesion">Iniciar Sesión</a>
                }
            </div>
        </div>
    </header>

    <div class="page-main">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="site-footer">
            <div class="site-footer__brand" aria-label="MarkStart logo">
                <img src="~/imagenes/Logo_alta.png" alt="MarkStart" />
            </div>

            <div class="site-footer__group">
                <h5>Links:</h5>
                <div class="site-footer__links">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                    <a asp-area="" asp-controller="Home" asp-action="Marketing">Marketing</a>
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("Usuario")))
                    {
                    <a asp-area="" asp-controller="Home" asp-action="Cursos">Cursos</a>
                    }
                </div>
            </div>

            <div class="site-footer__group">
                <h5>Contacto:</h5>
                <div class="site-footer__contact">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M3 6.75A2.75 2.75 0 0 1 5.75 4h12.5A2.75 2.75 0 0 1 21 6.75v10.5A2.75 2.75 0 0 1 18.25 20H5.75A2.75 2.75 0 0 1 3 17.25V6.75Zm2.1-.25 6.9 5.13 6.9-5.13H5.1Zm13.15 1.69-6.21 4.62a1 1 0 0 1-1.08 0L5.75 8.19v9.06c0 .41.34.75.75.75h11c.41 0 .75-.34.75-.75V8.19Z" fill="currentColor"/>
                        </svg>
                        <a href="mailto:info@markstart.com.ar">info@markstart.com.ar</a>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.35 2.3.53 3.5.53a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 4a1 1 0 0 1 1-1h3.1a1 1 0 0 1 1 1c0 1.2.18 2.4.53 3.5a1 1 0 0 1-.24 1l-2.16 2.2ZM14.5 2a7.5 7.5 0 0 1 7.5 7.5h-2a5.5 5.5 0 0 0-5.5-5.5V2Zm0 4a3.5 3.5 0 0 1 3.5 3.5h-2A1.5 1.5 0 0 0 14.5 9V6Z" fill="currentColor"/>
                        </svg>
                        <a href="tel:+5491112345678">+54 9 11 1234-5678</a>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 2.5A7.5 7.5 0 0 0 4.5 10c0 5.75 7.5 11.5 7.5 11.5s7.5-5.75 7.5-11.5A7.5 7.5 0 0 0 12 2.5Zm0 10.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill="currentColor"/>
                        </svg>
                        <span>Buenos Aires, Argentina</span>
                    </div>
                </div>
            </div>

            <div class="site-footer__social" aria-label="Redes sociales">
                <a href="#" class="social-link" aria-label="Instagram" title="Instagram">◎</a>
                <a href="#" class="social-link" aria-label="TikTok" title="TikTok">♪</a>
                <a href="#" class="social-link" aria-label="LinkedIn" title="LinkedIn">in</a>
                <a href="#" class="social-link" aria-label="X" title="X">X</a>
            </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
