<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarkStart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarkStart.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="page-header">
        <div class="header-inner">
            <div class="brand-block">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="MarkStart home">
                    <img src="~/imagenes/LogoHorizontal.png" alt="MarkStart" class="brand-logo" />
                </a>
            </div>

            @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); var isHome = currentController == "Home" && currentAction == "Index"; var isNosotros = currentController == "Home" && (currentAction == "Privacy" || currentAction == "Nosotros"); var isMarketing = currentController == "Home" && (currentAction == "Privacy" || currentAction == "Marketing"); var isCursos = currentController == "Home" && currentAction == "Cursos"; }
            <nav class="header-nav" aria-label="Main navigation">
                <a class="header-link @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="header-link @(isNosotros ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Nosotros</a>
                <a class="header-link @(isMarketing ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Marketing</a>
                @if (!string.IsNullOrEmpty(Context.Session.GetString("Usuario")))
                {
                    <a class="header-link @(isCursos ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Cursos">Cursos</a>
                }
            </nav>

            <div class="header-right">
                @{ var usuarioSesion = Context.Session.GetString("Usuario"); var nombreSesion = Context.Session.GetString("Nombre"); var fotoSesion = Context.Session.GetString("FotoPerfil"); }
                @if (!string.IsNullOrEmpty(usuarioSesion))
                {
                    <div class="user-block">
                        @if (!string.IsNullOrEmpty(fotoSesion))
                        {
                            <img src="@Url.Content("~/" + fotoSesion)" alt="FotoPerfil" class="user-avatar" />
                        }
                        else
                        {
                            <div class="user-avatar--placeholder"></div>
                        }
                        <div class="user-name">@(!string.IsNullOrEmpty(nombreSesion) ? nombreSesion : usuarioSesion)</div>
                    </div>
                }
                else
                {
                    <a class="btn-login" asp-area="" asp-controller="Home" asp-action="InicioSesion">Iniciar Sesión</a>
                }
            </div>
        </div>
    </header>

    <div class="page-main">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand" aria-label="MarkStart"></div>

            <div class="footer-section">
                <h5>Links:</h5>
                <ul class="footer-links list-unstyled">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Nosotros</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Marketing</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Cursos">Cursos</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h5>Contacto:</h5>
                <ul class="contact-list list-unstyled">
                    <li>info@markstart.com.ar</li>
                    <li>+54 9 11 1234-5678</li>
                    <li>Buenos Aires, Argentina</li>
                </ul>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
