@{
    ViewData["Title"] = "Inicio de Sesión";
}
<section class="registro-page registro-page--login">
    <h2 class="registro-title">Iniciar Sesión</h2>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger registro-alert">@ViewBag.Error</div>
    }

    <form class="registro-card registro-card--login" action="@Url.Action("InicioSesion", "Home")" method="post">
        <a href="/signin-google" class="google-auth-btn">
            Iniciar sesión con Google
        </a>
        <div class="registro-field registro-field--login">
            <label for="Email" class="form-label">Email</label>
            <input id="Email" name="Email" class="form-control" placeholder="MateoFernandez@gmail.com" />
        </div>

        <div class="registro-field registro-field--login registro-field--last">
            <label for="Contraseña" class="form-label">Contraseña</label>
            <input id="Contraseña" name="Contraseña" type="password" class="form-control" placeholder="..............." />
        </div>

        <input type="submit" class="registro-submit" value="Iniciar Sesión" />
    </form>
</section>