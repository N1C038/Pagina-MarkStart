@{
    ViewData["Title"] = "Registro";
}
<section class="registro-page">
    <h2 class="registro-title">Registrarse</h2>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
    {
        <div class="alert alert-success registro-alert">@ViewBag.Message</div>
    }
    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger registro-alert">@ViewBag.Error</div>
    }

    <form class="registro-card" action="@Url.Action("Registro", "Home")" method="post" enctype="multipart/form-data">

        <div class="registro-field">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" name="Nombre" placeholder="Mateo" />
        </div>

        <div class="registro-field">
            <label class="form-label">Apellido</label>
            <input type="text" class="form-control" name="Apellido" placeholder="Fernández" />
        </div>

        <div class="registro-field">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="Email" placeholder="MateoFernandez@gmail.com" />
        </div>

        <div class="registro-field">
            <label class="form-label">Teléfono</label>
            <input type="text" class="form-control" name="Telefono" placeholder="+54 9 11 1234-5678" />
        </div>

        <div class="registro-field">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-control" name="Contraseña" placeholder="..............." />
        </div>

        <div class="registro-field">
            <label class="form-label" for="FotoPerfil">Foto de Perfil</label>
            <input type="file" class="registro-file-input" name="FotoPerfil" id="FotoPerfil" />
            <label class="registro-file-button" for="FotoPerfil">+</label>
        </div>

        <input type="submit" class="registro-submit" value="Registrarse" />
    </form>
</section>
        