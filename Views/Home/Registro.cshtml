@{
    ViewData["Title"] = "Registro";
}
<section class="registro-page">
    <h2 class="registro-title">Registrarse</h2>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
    {
        <div class="alert alert-success registro-alert">@ViewBag.Message</div>
    }
    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger registro-alert">@ViewBag.Error</div>
    }

    <form id="registroForm" class="registro-card" action="@Url.Action("Registro", "Home")" method="post" onsubmit="return validarRegistro();">

        <div class="registro-field">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" name="Nombre" placeholder="Mateo" />
        </div>

        <div class="registro-field">
            <label class="form-label">Apellido</label>
            <input type="text" class="form-control" name="Apellido" placeholder="Fernández" />
        </div>

        <div class="registro-field">
            <label class="form-label">Email</label>
            <input id="Email" type="email" class="form-control" name="Email" placeholder="MateoFernandez@gmail.com" />
        </div>

        <div class="registro-field">
            <label class="form-label">Teléfono</label>
            <input id="Telefono" type="text" class="form-control" name="Telefono" placeholder="1123456789" />
        </div>

        <div class="registro-field">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-control" name="Contraseña" placeholder="..............." />
        </div>

        <input type="submit" class="registro-submit" value="Registrarse" />
    </form>

    <script>
        function validarRegistro() {
            var email = document.getElementById("Email").value;
            var telefono = document.getElementById("Telefono").value;
            var hayArroba = false;

            for (var i = 0; i < email.length; i++) {
                if (email[i] == "@@") {
                    hayArroba = true;
                }
            }

            if (!hayArroba) {
                return false;
            }

            for (var i = 0; i < telefono.length; i++) {
                if (telefono[i] < "0" || telefono[i] > "9") {
                    return false;
                }
            }

            return true;
        }
    </script>
</section>
