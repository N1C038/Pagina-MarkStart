@{
    ViewData["Title"] = "Cursos";
}

<div class="container mt-5">
    @if (ViewBag.CursosComprados != null && ViewBag.CursosComprados.Count > 0)
    {
        <div class="dropdown-menu">
            @foreach (var startup in ViewBag.Startups)
            {
                <a class="dropdown-item" href="@Url.Action("Cursos", "Home", new { IdStartup = startup.IdStartup })">@startup.Nombre</a>
            }
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="@Url.Action("AgregarStartup", "Home")">Agrega una startup</a>
        </div>
        
    
        <h2 class="text-center mb-4">Tus Cursos</h2>
        <div class="row">
            @foreach (var curso in ViewBag.CursosComprados)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(curso.FotoCurso))
                        {
                            <img src="/imagenes/@curso.FotoCurso" class="card-img-top" alt="@curso.Nombre" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                                <span class="text-white">Sin imagen</span>
                            </div>
                        }
                        <div class="card-footer bg-white">
                            <a href="@Url.Action("Tareas", "Home", new { Id = curso.IdCurso })" class="btn btn-primary w-100">Entrar</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (ViewBag.CursosRecomendados != null && ViewBag.CursosRecomendados.Count > 0)
    {
        <h2 class="text-center mb-4">Cursos Recomendados</h2>
        <div class="row">
            @foreach (var curso in ViewBag.CursosRecomendados)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(curso.FotoCurso))
                        {
                            <img src="@curso.FotoCurso" class="card-img-top" alt="@curso.Nombre" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                                <span class="text-white">Sin imagen</span>
                            </div>
                        }
                        <div class="card-footer bg-white">
                            <button class="btn btn-primary w-100">Ver Detalles</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4>No hay cursos disponibles</h4>
            <p>Por favor, intente más tarde.</p>
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2) !important;
    }

    .card-title {
        color: #333;
        font-weight: 600;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }
</style>
