@{
    ViewData["Title"] = "Cursos";
}

<div class="container mt-5 markstart-cursos-page">
    @if (ViewBag.Startups != null && ViewBag.Startups.Count > 0)
    {
        <div class="markstart-cursos-toolbar">
            <div class="dropdown">
                <button class="btn markstart-cursos-dropdown dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @(ViewBag.NombreStartup ?? "Seleccionar startup")
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @foreach (var startup in ViewBag.Startups)
                    {
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Cursos", "Home", new { IdStartup = startup.IdStartup })">@startup.Nombre</a>
                        </li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("AgregarStartup", "Home", new { IdStartup = 0 })">Agregar una Startup</a>
                    </li>
                </ul>
            </div>
        </div>
    }

    @if (ViewBag.CursosComprados != null && ViewBag.CursosComprados.Count > 0)
    {
        <h2 class="markstart-cursos-section__title">Tus Cursos</h2>
        <div class="markstart-course-gallery__items">
            @foreach (var curso in ViewBag.CursosComprados)
            {
                <div class="markstart-course-card">
                    <div class="markstart-course-item">
                        <img src="/imagenes/@curso.FotoCurso" alt="@curso.Nombre">
                        <a href="@Url.Action("Tareas", "Home", new { Id = curso.IdCurso })" class="markstart-course-item__info">Entrar</a>
                    </div>
                    <h4>@curso.Nombre</h4>
                </div>
            }
        </div>
    }
    @if (ViewBag.CursosRecomendados != null && ViewBag.CursosRecomendados.Count > 0)
    {
        <h2 class="markstart-cursos-section__title markstart-cursos-section__title--spaced">Cursos Recomendados</h2>
        <div class="markstart-course-gallery__items">
            @foreach (var curso in ViewBag.CursosRecomendados)
            {
                <div class="markstart-course-card">
                    <div class="markstart-course-item">
                        <img src="/imagenes/@curso.FotoCurso" alt="@curso.Nombre">
                        <button class="markstart-course-item__info">Más información</button>
                    </div>
                    <h4>@curso.Nombre</h4>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4>No hay cursos disponibles</h4>
            <p>Por favor, intente más tarde.</p>
        </div>
    }
</div>


