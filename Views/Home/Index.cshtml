@{
    ViewData["Title"] = "Home Page";
}

@if (ViewBag.Usuario != "")
{
    <div class="markstart-user">
        <h1 class="markstart-user__title">Bienvenido <span>@ViewBag.Usuario</span></h1>
        <h2 class="markstart-user__subtitle">¿Que vas a hacer hoy?</h2>

        @if (ViewBag.Cursos == null || ViewBag.Cursos.Count == 0)
        {
            <div class="markstart-empty">
                <h5 class="markstart-empty__title">No tienes cursos comprados</h5>
                <a href="@Url.Action("Cursos", "Home", new { IdStartup = 0 })" class="markstart-btn">Comprar un Nuevo Curso</a>
            </div>
        }
        else
        {
            @foreach (KeyValuePair<Curso, Tarea> curso in ViewBag.Cursos)
            {
                <h5 class="markstart-card__title">@curso.Key.Nombre</h5>
                <div class="markstart-card">
                    <div class="markstart-card__body">
                        <div class="markstart-card__content">
                            @if (curso.Value != null)
                            {
                                <h6>@curso.Value.Nombre</h6>
                                <p>@curso.Value.Explicacion</p>
                            }
                            else
                            {
                                <h6>Curso completado</h6>
                                <p>Ya no tienes tareas pendientes para este curso.</p>
                            }
                        </div>
                        <div class="markstart-card__action">
                            @if (curso.Value != null)
                            {
                                <a href="@Url.Action("Tareas", "Home", new {Id = curso.Key.IdCurso })" class="markstart-btn">Hacer Tareas</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}
else
{
    <div class="markstart-guest">
        <h1 class="markstart-guest__title">¿Querés aprender marketing?</h1>
        <h2 class="markstart-guest__subtitle">¡Entonces MarkStart es tu solución!</h2>

        <div class="markstart-guest__cta">
            <a href="@Url.Action("Registro", "Home")" class="markstart-btn markstart-btn--primary">Registrarse</a>
        </div>

        <div class="markstart-hero-carousel">
            <div id="carouselHero" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="hero-slide hero-slide--marketing">
                            <div class="hero-card">
                                <h3>¿Qué es el marketing?</h3>
                                
                                <a href="@Url.Action("Marketing", "Home")" class="markstart-btn markstart-btn--primary">Conoce más</a>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <div class="hero-slide hero-slide--team">
                            <div class="hero-card">
                                <h3>¿Quiénes somos?</h3>
                                <a href="@Url.Action("MarkStart", "Home")" class="markstart-btn markstart-btn--primary">Conoce más</a>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="carousel-control-prev hero-arrow hero-arrow--prev" type="button" data-bs-target="#carouselHero" data-bs-slide="prev" aria-label="Anterior">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next hero-arrow hero-arrow--next" type="button" data-bs-target="#carouselHero" data-bs-slide="next" aria-label="Siguiente">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>

                <div class="carousel-indicators hero-dots">
                    <button type="button" data-bs-target="#carouselHero" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselHero" data-bs-slide-to="1" aria-label="Slide 2"></button>
                </div>
            </div>
        </div>
    </div>

    <div class="markstart-about-section">
        <div class="markstart-about-grid">
            <div class="markstart-about-box">
                <h3>Misión</h3>
                <p>Nuestra misión es ayudar a que los emprendedores aprendan marketing y puedan aplicar estrategias que les permitan crecer, conectar con su audiencia y alcanzar resultados reales.</p>
            </div>

            <div class="markstart-about-box">
                <h3>Visión</h3>
                <p>Nuestra visión es que en todas las empresas, emprendedores y negocios puedan acceder a herramientas de marketing y tengan éxito a nivel global.</p>
            </div>
        </div>

        <div class="markstart-about-banner">
            <div class="markstart-about-banner__item">
                <div class="markstart-about-banner__icon">✓</div>
                <div class="markstart-about-banner__content">
                    <h4>El Mito común</h4>
                    <p>“Marketing es publicar sin rumbo y pagar publicidad sin estrategia, esperando un milagro inesperado.”</p>
                </div>
            </div>

            <div class="markstart-about-banner__item">
                <div class="markstart-about-banner__icon">✓</div>
                <div class="markstart-about-banner__content">
                    <h4>El método MarkStart</h4>
                    <p>Un proceso pedagógico diseñado para ayudar a los emprendedores a construir estrategias, ejecutar mejor sus acciones y convertir su esfuerzo en resultados.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="markstart-course-gallery">
        <h3>Algunos de nuestros cursos</h3>
        <div class="markstart-course-gallery__items">
            @foreach (var curso in ViewBag.Cursos)
            {
                <div class="markstart-course-card">
                    <div class="markstart-course-item">
                        <img src="/imagenes/@curso.FotoCurso" alt="@curso.Nombre">
                        <a href="@Url.Action("DetalleCurso", "Home", new { id = curso.IdCurso })" class="markstart-course-item__info">Más información</a>
                    </div>
                    <h4>@curso.Nombre</h4>
                </div>
            }
        </div>
    </div>

    <div class="markstart-review-gallery">
        <h3>Algunas opiniones sobre MarkStart</h3>
        <div class="markstart-review-gallery__items">
            @foreach (var reseña in ViewBag.Reseñas)
            {
                <article class="markstart-review-item">
                    <div class="markstart-review-item__header">
                        <h4>@reseña.Nombre</h4>
                    </div>
                    <div class="markstart-review-item__body">
                        <div class="markstart-review-item__photo">
                            <img src="/imagenes/@reseña.Imagen" alt="@reseña.Nombre">
                        </div>
                        <div class="markstart-review-item__quote">
                            <p>@reseña.Texto</p>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
}

